#lang rhombus/static

import lib("graph-executor/main.rkt") as main
import lib("graph-executor/graph.rkt") as g
import lib("graph-executor/model.rkt") as m
import lib("graph-executor/executor/console.rkt") as console

import:
  rhombus/meta:
    open

expr.macro 'code($e)':
  'g.#{make-code}(g.#{code-text}($(e.to_source_string())), $e)'

annot.macro 'Graph':
  annot_meta.pack_predicate(
    'g.#{graph?}'
  )

annot.macro 'OpenGraph':
  annot_meta.pack_predicate(
    'g.#{open-graph?}'
  )

annot.macro 'Node':
  annot_meta.pack_predicate(
    'g.#{node?}'
  )

annot.macro 'Edge':
  annot_meta.pack_predicate(
    'g.#{edge?}'
  )

annot.macro 'Bridge':
  annot_meta.pack_predicate(
    'g.#{bridge?}'
  )

fun node_maker(graph_name):
  def make_node = g.#{node-maker}(graph_name)
  fun (name, ~type: type, ~tags: tags = [], ~desc: desc = #false, ~trans: trans = #false, ~before: before = #false, ~after: after = #false, ~prompt: prompt = #false, ~options: options = []) :: Node:
    make_node(name, ~type, ~tags: PairList[& tags], ~desc, ~trans, ~before, ~after, ~prompt, ~options: PairList[& options])

fun make_edge(name, ~mode = #false, ~is_half = #false, ~from, ~to, ~desc = #false, ~when: w = #false, ~trans = #false, ~before = #false, ~after = #false, ~priority = #false, ~options = []) :: Edge:
  main.#{make-edge}(name, ~mode, ~#{half?}: is_half, ~from, ~to, ~desc, ~when: w, ~trans, ~before, ~after, ~priority, ~options: PairList[& options])

fun make_bridge(name, ~mode = #false, ~is_half = #false, ~from, ~to, ~desc = #false, ~when: w = #false, ~trans = #false, ~before = #false, ~after = #false, ~priority = #false, ~options = []) :: Bridge:
  main.#{make-bridge}(name, ~mode, ~#{half?}: is_half, ~from, ~to, ~desc, ~when: w, ~trans, ~before, ~after, ~priority, ~options: PairList[& options])

macro 'any_node($annot)':
  'g.#{any-node/any}(fun (x): x is_a $annot)'

macro 'any_graph($annot)':
  'g.#{any-graph/any}(fun (x): x is_a $annot)'

fun checker_config(~prompt = checker_prompt_config(), ~trace_display = #'hide):
  main.#{checker-config}(~prompt, ~#{trace-display}: trace_display)

fun checker_prompt_config(~string_values = main.#{default-checker-prompt-string-values},
                          ~integer_values = main.#{default-checker-prompt-integer-values},
                          ~natural_values = main.#{default-checker-prompt-natural-values},
                          ~positive_integer_values = main.#{default-checker-prompt-positive-integer-values},
                          ~between_values = main.#{default-checker-prompt-between-values},
                          ~random_values = main.#{default-checker-prompt-random-values}):
  main.#{checker-prompt-config}(~#{string-values}: string_values,
                                ~#{integer-values}: integer_values,
                                ~#{natural-values}: natural_values,
                                ~#{positive-integer-values}: positive_integer_values,
                                ~#{between-values}: between_values,
                                ~#{random-values}: random_values)

annot.macro 'ConsoleCommand':
  annot_meta.pack_predicate(
    'console.#{console-command?}'
  )

fun console_config(~commands: commands :: List.of(ConsoleCommand) || PairList.of(ConsoleCommand) = main.#{default-console-commands},
                   ~trace_display = #'show,
                   ~chooser = main.#{default-console-chooser}):
  main.#{console-config}(~commands: PairList[& commands],
                         ~#{trace-display}: trace_display,
                         ~chooser)

fun make_graph(name, ~parent_name = #false, ~desc = #false, ~edges):
  main.#{make-graph}(name, ~#{parent-name}: parent_name, ~desc, ~edges: PairList[& edges])

fun make_open_graph(name, ~parent_name = #false, ~desc = #false, ~edges, ~bridges):
  main.#{make-open-graph}(name, ~#{parent-name}: parent_name, ~desc, ~edges: PairList[& edges], ~bridges: PairList[& bridges])

fun dot_config(~global = #false, ~node = #false, ~node_label = #false, ~edge_node = #false, ~edge_node_label = #false, ~edge = #false):
  main.#{dot-config}(~global, ~node, ~#{node-label}: node_label, ~#{edge-node}: edge_node, ~#{edge-node-label}: edge_node_label, ~edge)

annot.macro 'RawNodeInfo':
  annot_meta.pack_predicate(
    'g.#{node-info?}',
  )

veneer NodeInfo(this :: RawNodeInfo):
  property name:
    g.#{node-info-name}(this)
  property type:
    g.#{node-info-type}(this)
  property tags:
    g.#{node-info-tags}(this)
  property desc:
    g.#{node-info-desc}(this)

annot.macro 'RawJournalEntry':
  annot_meta.pack_predicate(
    'main.#{journal-entry?}',
  )

veneer JournalEntry(this :: RawJournalEntry):
  property edge_mode:
    main.#{journal-entry-edge-mode}(this)
  property edge_name:
    main.#{journal-entry-edge-name}(this)
  property edge_attributes:
    main.#{journal-entry-edge-attributes}(this)
  property prompt_records:
    main.#{journal-entry-prompt-records}(this)

fun auto_journal_entry(edge_name, ~prompt_records = []):
  main.#{auto-journal-entry}(edge_name, ~#{prompt-records}: PairList[& prompt_records])

fun choose_journal_entry(edge_name, ~edge_attributes = [], ~prompt_records = []):
  main.#{choose-journal-entry}(edge_name, ~#{edge-attributes}: PairList[& edge_attributes], ~#{prompt-records}: PairList[& prompt_records])

annot Journal = PairList.of(JournalEntry)
fun Journal(&entries :: List.of(JournalEntry)):
  PairList[& List.reverse(entries)]

annot.macro 'RawModel':
  annot_meta.pack_predicate(
    'm.#{model?}',
  )

veneer Model(this :: RawModel):
  method apply_journal(journal :: Journal) :: values(NodeInfo, Any):
    main.#{apply-journal}(this, journal)
  method console_run(~journal: journal :: Journal = Journal(), ~config: config = main.#{console-config}()) :: Journal:
    main.#{console-run}(this, ~journal, ~config)
  method render_dot(~journal: journal :: Journal = Journal(), ~port: port :: Port.Output = stdout, ~config: config = main.#{dot-config}()):
    main.#{render-dot}(this, ~journal, ~port, ~config)
  method find_witness(predicate :: (NodeInfo, Any) -> Any,
                      ~bound: bound :: Nat || False = #false,
                      ~bounded: bounded :: () -> (False || Journal) = fun (): #false,
                      ~config: config = main.#{checker-config}()):
    main.#{find-witness}(this, predicate, ~bound, ~bounded, ~config)
  method find_counterexample(invariant :: (NodeInfo, Any) -> Any,
                             ~bound: bound :: Nat || False = #false,
                             ~bounded: bounded :: () -> (False || Journal) = fun (): #false,
                             ~config: config = main.#{checker-config}()):
    main.#{find-counterexample}(this, invariant, ~bound, ~bounded, ~config)
  method find_deadlock(is_terminal_node :: NodeInfo -> Any,
                       ~bound: bound :: Nat || False = #false,
                       ~bounded: bounded :: () -> (False || Journal) = fun (): #false,
                       ~config: config = main.#{checker-config}()):
    main.#{find-deadlock}(this, is_terminal_node, ~bound, ~bounded, ~config)    
  method find_false_terminal(is_terminal_node :: NodeInfo -> Any,
                             ~bound: bound :: Nat || False = #false,
                             ~bounded: bounded :: () -> (False || Journal) = fun (): #false,
                             ~config: config = main.#{checker-config}()):
    main.#{find-false-terminal}(this, is_terminal_node, ~bound, ~bounded, ~config)
  method find_livelock(~config: config = main.#{checker-config}()) :: False || Journal:
    main.#{find-livelock}(this, ~config)
  method find_auto_conflict(~bound: bound :: Nat || False = #false,
                            ~bounded: bounded :: () -> (False || Journal) = fun (): #false,
                            ~config: config = main.#{checker-config}()):
    main.#{find-auto-conflict}(this, ~bound, ~bounded, ~config)

fun model(proc :: () -> values(List.of(Graph), Node, Any),
          ~default_node_prompt: default_node_prompt :: String = "Choose:") :: Model:
  main.model(
    ~#{default-node-prompt}: default_node_prompt,
    fun ():
      def values(gs, n, st) = proc()
      values(PairList[& gs], n, st),
  )

export:
  Node Edge Bridge Graph OpenGraph
  NodeInfo
  Journal JournalEntry
  auto_journal_entry choose_journal_entry
  Model

  code model node_maker make_edge make_bridge make_graph make_open_graph checker_config checker_prompt_config console_config dot_config
  any_node any_graph

  rename:
    main.message as message
    main.#{prompt-choose} as prompt_choose
    main.#{prompt-string} as prompt_string
    main.#{prompt-integer} as prompt_integer
    main.#{prompt-natural} as prompt_natural
    main.#{prompt-positive-integer} as prompt_positive_integer
    main.#{prompt-between} as prompt_between
    main.#{prompt-random} as prompt_random
    main.#{weight-edge-option} as weight_edge_option
    main.#{default-console-commands} as default_console_commands
    main.#{default-console-chooser} as default_console_chooser
    main.#{default-checker-prompt-string-values} as default_checker_prompt_string_values
    main.#{default-checker-prompt-integer-values} as default_checker_prompt_integer_values
    main.#{default-checker-prompt-natural-values} as default_checker_prompt_natural_values
    main.#{default-checker-prompt-positive-integer-values} as default_checker_prompt_positive_integer_values
    main.#{default-checker-prompt-between-values} as default_checker_prompt_between_values
    main.#{default-checker-prompt-random-values} as default_checker_prompt_random_values
    main.#{dot-global-config} as dot_global_config
    main.#{dot-node-config} as dot_node_config
    main.#{dot-edge-config} as dot_edge_config
    main.#{default-dot-node-config} as default_dot_node_config
    main.#{default-dot-edge-node-config} as default_dot_edge_node_config
    main.#{default-dot-edge-config} as default_dot_edge_config
    main.#{default-dot-node-label-config} as default_dot_node_label_config
    main.#{default-dot-edge-node-label-config} as default_dot_edge_node_label_config
    main.#{dot-edge-option} as dot_edge_option
    main.#{transform-console-command} as transform_console_command
    main.#{action-console-command} as action_console_command
    main.#{restore-console-command} as restore_console_command
    main.#{quit-console-command} as quit_console_command
